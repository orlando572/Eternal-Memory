# Plantilla de variables para `docker compose` (TSK-44).
# Copia este archivo a `.env` y edítalo. `.env` no se sube al repositorio.
# Todos los valores son de ejemplo: no contienen secretos reales.

# --- Tienda (servicio app) ---
# Con estos valores de ejemplo la imagen compila y la tienda abre, pero no se conecta a ningún
# Supabase. Para trabajar con el proyecto real, sustitúyelos por los de Supabase
# (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=ci-public-placeholder
# Dirección pública de la tienda (sitemap y vista previa al compartir). Opcional.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Clave privada de Supabase: solo en el servidor, nunca en la imagen.
SUPABASE_SECRET_KEY=
# Pago de prueba con Stripe (claves de prueba: sk_test_… y whsec_…). Opcionales para abrir la tienda.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Puerto de la tienda en este equipo.
APP_PORT=3000

# --- Base de datos local (servicio db) ---
DB_PASSWORD=postgres
DB_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# Puerto de la base de datos en este equipo (solo accesible desde él).
DB_PORT=54322
